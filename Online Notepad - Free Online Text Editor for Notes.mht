.dropdown .divider { width: auto; background-color: var(--color-gray-light); margin: 4px 12px; height: 1px; }

.shortcut { display: inline-flex; align-items: center; gap: 1px; flex-shrink: 0; }

.shortcut .shortcut-key, .shortcut .shortcut-plus { font-family: inherit; font-size: 10px; font-weight: 400; line-height: 12px; color: var(--paragraph); }

