@charset "utf-8";

@import url("https://fonts.googleapis.com/css?family=Reenie+Beanie");

.editor-shell { max-width: 100%; color: rgb(0, 0, 0); position: relative; line-height: 1.7; font-weight: 400; }

.editor-shell .editor-container { background: var(--color-white); position: relative; display: block; }

.editor-shell .editor-container.tree-view { border-radius: 0px; }

.editor-shell .editor-container.plain-text { border-top-left-radius: 10px; border-top-right-radius: 10px; }

.editor-scroller { min-height: 150px; max-width: 100%; border: 0px; display: flex; position: relative; outline: 0px; z-index: 0; resize: vertical; }

.editor { flex: 1 1 auto; max-width: 100%; position: relative; resize: vertical; z-index: -1; }

.test-recorder-output { margin: 20px auto; width: 100%; }

pre { line-height: 1.1; background: rgb(34, 34, 34); color: var(--color-white); margin: 0px; padding: 10px; font-size: 12px; overflow: auto; max-height: 400px; }

.tree-view-output { display: block; background: rgb(34, 34, 34); color: var(--color-white); padding: 0px; font-size: 12px; margin: 1px auto 10px; position: relative; overflow: hidden; border-bottom-left-radius: 10px; border-bottom-right-radius: 10px; }

pre::-webkit-scrollbar { background: transparent; width: 10px; }

pre::-webkit-scrollbar-thumb { background: rgb(153, 153, 153); }

.editor-dev-button { position: relative; display: block; width: 40px; height: 40px; font-size: 12px; border-radius: 20px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; cursor: pointer; outline: none; box-shadow: rgba(0, 0, 0, 0.3) 0px 1px 10px; background-color: rgb(68, 68, 68); }

.editor-dev-button::after { content: ""; position: absolute; inset: 10px; display: block; background-size: contain; filter: invert(1); }

.editor-dev-button:hover { background-color: rgb(85, 85, 85); }

.editor-dev-button.active { background-color: rgb(233, 35, 35); }

.test-recorder-toolbar { display: flex; }

.test-recorder-button { position: relative; display: block; width: 32px; height: 32px; font-size: 10px; padding: 6px; border-radius: 4px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; cursor: pointer; outline: none; box-shadow: rgba(0, 0, 0, 0.4) 1px 2px 2px; background-color: rgb(34, 34, 34); transition: box-shadow 50ms ease-out; }

.test-recorder-button:active { box-shadow: rgba(0, 0, 0, 0.4) 1px 2px 4px; }

.test-recorder-button + .test-recorder-button { margin-left: 4px; }

.test-recorder-button::after { content: ""; position: absolute; inset: 8px; display: block; background-size: contain; filter: invert(1); }

#options-button { position: fixed; left: 20px; bottom: 20px; }

#test-recorder-button { position: fixed; left: 70px; bottom: 20px; }

#paste-log-button { position: fixed; left: 120px; bottom: 20px; }

#docs-button { position: fixed; left: 170px; bottom: 20px; }

#options-button::after { background-image: url("/build/assets/gear--2P1SjXQ.svg"); }

#test-recorder-button::after { background-image: url("/build/assets/journal-code-B9Pw657Y.svg"); }

